{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run format:check",
    "wiki:sync": "bun scripts/sync-wiki.ts",
    "brand": "python -I scripts/build-brand.py",
    "oss:snapshot": "bun scripts/open-source-snapshot.ts",
    "agent-docs:check": "bun scripts/check-agent-docs.ts",
    "mcp:check": "bun scripts/check-mcp.ts",
    "indexnow": "bun scripts/indexnow.ts",
    "mcp:registry": "bun scripts/mcp-registry.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
